@using AutoServePro.Controllers
@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-4">
        <h2>Users</h2>
        <div style="max-height: 400px; overflow-y: auto;">
            <ul class="list-group">
                @foreach (var user in Model.Users)
                {
                    <li class="list-group-item">@user.FullName (@user.Role)</li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-4">
        <h2>Appointments</h2>
        <div style="max-height: 400px; overflow-y: auto;">
            <ul class="list-group">
                @foreach (var appointment in Model.Appointments)
                {
                    <li class="list-group-item">
                        @appointment.User.FullName - @appointment.Service.Name<br />
                        Status: @appointment.Status
                        <form asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@appointment.Id" />
                            <select name="status" class="form-select form-select-sm d-inline w-auto">
                                <option value="Pending" selected="@(appointment.Status == AppointmentStatus.Pending)">Pending</option>
                                <option value="Confirmed" selected="@(appointment.Status == AppointmentStatus.Confirmed)">Confirmed</option>
                                <option value="InProgress" selected="@(appointment.Status == AppointmentStatus.InProgress)">In Progress</option>
                                <option value="Completed" selected="@(appointment.Status == AppointmentStatus.Completed)">Completed</option>
                                <option value="Cancelled" selected="@(appointment.Status == AppointmentStatus.Cancelled)">Cancelled</option>
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">Update</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-4">
        <h2>Services</h2>
        <a class="btn btn-primary mb-3" asp-action="AddService">Add Service</a>
        <div style="max-height: 400px; overflow-y: auto;">
            <ul class="list-group">
                @foreach (var service in Model.Services)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @service.Name
                        <span class="badge bg-primary rounded-pill">₹@service.Price.ToString("F2")</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
