@model IEnumerable<AutoServePro.Models.Service>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to AutoServePro</h1>
    <p class="lead">Vehicle Service Management System</p>
</div>

<div class="row">
    <div class="col-md-6">
        <h2>Available Services</h2>
        <div style="max-height: 400px; overflow-y: auto;">
            <ul class="list-group">
                @foreach (var service in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @service.Name
                        <span class="badge bg-primary rounded-pill">₹@service.Price.ToString("F2")</span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        @if (User.Identity.IsAuthenticated)
        {
            <div class="alert alert-info">
                Welcome back, @User.Identity.Name!
            </div>
            <h2>Quick Actions</h2>
            <p>Manage your vehicle service appointments.</p>
            <a class="btn btn-primary" asp-controller="Customer" asp-action="Dashboard">Go to Dashboard</a>
        }
        else
        {
            <h2>Get Started</h2>
            <p>Register as a customer to book appointments or as an admin to manage the system.</p>
            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Register</a>
            <a class="btn btn-secondary" asp-controller="Account" asp-action="Login">Login</a>
        }
    </div>
</div>
